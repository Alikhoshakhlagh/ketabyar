# این فایل را کپی کنید و نامش را .env بگذارید، سپس مقادیر را عوض کنید.

# ---- پایگاه داده (PostgreSQL) ----
DB_ENGINE=postgres
DB_NAME=ketabyar
DB_USER=ketabyar
DB_PASSWORD=رمزی_که_در_setup_db.sql_گذاشتید
DB_HOST=localhost
# پورت پیش‌فرض PostgreSQL عدد 5432 است؛ روی این کامپیوتر 5433 نصب شده
DB_PORT=5433

# برای اجرای سریع بدون PostgreSQL (فقط تست)، مقدار DB_ENGINE بالا را sqlite بگذارید.

# ---- امنیت ----
SECRET_KEY=یک-رشته‌ی-طولانی-و-تصادفی
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
